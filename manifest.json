{
  "manifest_version": 3,
  "name": "Tab Groups Manager",
  "version": "1.0.0",
  "description": "Organize, save, and restore Chrome tab groups with nested folders, auto-sync, and dark mode.",
  "permissions": [
    "tabGroups",
    "tabs",
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Tab Groups Manager",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "Open Tab Groups Manager"
    }
  }
}
